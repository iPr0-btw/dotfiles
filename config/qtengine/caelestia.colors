[ColorEffects:Disabled]
Color={{ $surfaceContainer }}
ColorAmount=0.5
ColorEffect=3
ContrastAmount=0
ContrastEffect=0
IntensityAmount=0
IntensityEffect=0

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color={{ $surfaceContainerLowest }}
ColorAmount=0.025
ColorEffect=0
ContrastAmount=0.1
ContrastEffect=0
Enable=true
IntensityAmount=0
IntensityEffect=0

[Colors:Button]
BackgroundAlternate=#000000
BackgroundNormal={{ $surfaceContainerHigh }}
DecorationFocus=#5B7C99
DecorationHover=#5B7C99
ForegroundActive=#B0B0B0
ForegroundInactive=#444444
ForegroundLink={{ $klink }}
ForegroundNegative={{ $knegative }}
ForegroundNeutral={{ $kneutral }}
ForegroundNormal=#B0B0B0
ForegroundPositive={{ $kpositive }}
ForegroundVisited={{ $kvisited }}

[Colors:Complementary]
