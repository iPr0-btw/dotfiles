[ColorEffects:Disabled]
Color={{ $surfaceContainer }}
ColorAmount=0.5
ColorEffect=3
ContrastAmount=0
ContrastEffect=0
IntensityAmount=0
IntensityEffect=0

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color={{ $surfaceContainerLowest }}
ColorAmount=0.025
ColorEffect=0
ContrastAmount=0.1
ContrastEffect=0
Enable=false
IntensityAmount=0
IntensityEffect=0

[Colors:Button]
BackgroundAlternate=#000000
BackgroundNormal={{ $surfaceContainerHigh }}
DecorationFocus=#0080FF
DecorationHover=#0080FF
ForegroundActive=#FFFFFF
ForegroundInactive=#555555
ForegroundLink={{ $klink }}
ForegroundNegative={{ $knegative }}
ForegroundNeutral={{ $kneutral }}
ForegroundNormal=#FFFFFF
ForegroundPositive={{ $kpositive }}
ForegroundVisited={{ $kvisited }}

[Colors:Complementary]
BackgroundAlternate=#000000
BackgroundNormal={{ $surfaceContainer }}
DecorationFocus=#0080FF
DecorationHover=#0080FF
ForegroundActive={{ $inverseSurface }}
ForegroundInactive=#555555
ForegroundLink={{ $klink }}
ForegroundNegative={{ $knegative }}
ForegroundNeutral={{ $kneutral }}
ForegroundNormal=#CCCCCC
ForegroundPositive={{ $kpositive }}
ForegroundVisited={{ $kvisited }}

[Colors:Header]
BackgroundAlternate={{ $surfaceContainer }}
BackgroundNormal={{ $surfaceContainer }}
DecorationFocus=#0080FF
DecorationHover=#0080FF
ForegroundActive={{ $inverseSurface }}
ForegroundInactive=#555555
ForegroundLink={{ $klink }}
ForegroundNegative={{ $knegative }}
ForegroundNeutral={{ $kneutral }}
ForegroundNormal=#CCCCCC
ForegroundPositive={{ $kpositive }}
ForegroundVisited={{ $kvisited }}

[Colors:Header][Inactive]
BackgroundAlternate={{ $surfaceContainer }}
BackgroundNormal={{ $surfaceContainer }}
DecorationFocus=#0080FF
DecorationHover=#0080FF
ForegroundActive={{ $inverseSurface }}
ForegroundInactive=#555555
ForegroundLink={{ $klink }}
ForegroundNegative={{ $knegative }}
ForegroundNeutral={{ $kneutral }}
ForegroundNormal=#CCCCCC
ForegroundPositive={{ $kpositive }}
ForegroundVisited={{ $kvisited }}

[Colors:Selection]
BackgroundAlternate=#0080FF
BackgroundNormal=#0080FF
DecorationFocus=#0080FF
DecorationHover=#00FF00
ForegroundActive=#000000
ForegroundInactive=#000000
ForegroundLink={{ $klinkSelection }}
ForegroundNegative={{ $knegativeSelection }}
ForegroundNeutral={{ $kneutralSelection }}
ForegroundNormal=#000000
ForegroundPositive={{ $kpositiveSelection }}
ForegroundVisited={{ $kvisitedSelection }}

[Colors:Tooltip]
BackgroundAlternate=#000000
BackgroundNormal={{ $surfaceContainer }}
DecorationFocus=#0080FF
DecorationHover=#0080FF
ForegroundActive=#FFFFFF
ForegroundInactive=#555555
ForegroundLink={{ $klink }}
ForegroundNegative={{ $knegative }}
ForegroundNeutral={{ $kneutral }}
ForegroundNormal=#FFFFFF
ForegroundPositive={{ $kpositive }}
ForegroundVisited={{ $kvisited }}

[Colors:View]
BackgroundAlternate={{ $surfaceContainer }}
BackgroundNormal={{ $surfaceBright }}
DecorationFocus=#0080FF
#-----------------------------------------------
DecorationHover={{ $secondaryFixed }}
ForegroundActive={{ $inverseSurface }}
ForegroundInactive=#555555
ForegroundLink={{ $klink }}
ForegroundNegative={{ $knegative }}
ForegroundNeutral={{ $kneutral }}
ForegroundNormal=#FFFFFF
ForegroundPositive={{ $kpositive }}
ForegroundVisited={{ $kvisited }}

[Colors:Window]
BackgroundAlternate=#000000
BackgroundNormal={{ $surfaceContainer }}
DecorationFocus=#0080FF
DecorationHover=#0080FF
ForegroundActive={{ $klink }}
ForegroundInactive=#555555
ForegroundLink={{ $klink }}
ForegroundNegative={{ $knegative }}
ForegroundNeutral={{ $kneutral }}
#--- Window titles, context icons
ForegroundNormal=#CCCCCC
ForegroundPositive={{ $kpositive }}
ForegroundVisited={{ $kvisited }}

[General]
ColorScheme=Caelestia
Name=Caelestia
shadeSortColumn=true

[KDE]
contrast=4

[WM]
activeBackground={{ $surfaceContainerHighest }}
activeBlend=227,229,231
activeForeground=#FFFFFF
inactiveBackground={{ $secondaryContainer }}
inactiveBlend=239,240,241
inactiveForeground=#CCCCCC
