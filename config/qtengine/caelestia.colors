[ColorEffects:Disabled]
Color={{ $surfaceContainer }}
ColorAmount=0.5
ColorEffect=3
ContrastAmount=0
ContrastEffect=0
IntensityAmount=0
IntensityEffect=0

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color={{ $surfaceContainerLowest }}
ColorAmount=0.025
ColorEffect=0
ContrastAmount=0.1
ContrastEffect=0
Enable=true
IntensityAmount=0
IntensityEffect=0

[Colors:Button]
BackgroundAlternate=#000000
BackgroundNormal={{ $surfaceContainerHigh }}
DecorationFocus=#7AA2F7
DecorationHover=#7AA2F7
ForegroundActive=#C0CAF5
ForegroundInactive=#bbbbbb
ForegroundLink={{ $klink }}
ForegroundNegative={{ $knegative }}
ForegroundNeutral={{ $kneutral }}
ForegroundNormal=#C0CAF5
ForegroundPositive={{ $kpositive }}
ForegroundVisited={{ $kvisited }}

