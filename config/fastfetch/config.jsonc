{
"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
"logo": {
"padding": {
"top": 1
},
    "color": {
      "1": "#FFB6D1",
      "2": "#FFB6D1",
      "4": "red"
    },
},

"display": {
"separator": " 󰑃  "
},
"modules": [
    "break",
    {
    "type": "os",
    "key": " DISTRO",
    "keyColor": "yellow"
    },
    {
    "type": "kernel",
    "key": "│ ├",
    "keyColor": "yellow"
    },
    {
    "type": "packages",
    "key": "│ ├󰏖",
    "keyColor": "yellow"
    },
    {
    "type": "shell",
    "key": "│ └",
    "keyColor": "yellow"
    },
    {
    "type": "de",
    "key": " DE",
    "keyColor": "red"
    },
    {
    "type": "wm",
    "key": " WM",
    "keyColor": "blue"
    },
    {
    "type": "wmtheme",
    "key": "│ ├󰉼",
    "keyColor": "green"
    },
    {
    "type": "icons",
    "key": "│ ├󰀻",
    "keyColor": "yellow"
    },
    {
        "type": "cursor",
        "key": "│ ├",
        "keyColor": "blue",
    },
    {
        "type": "terminalfont",
        "key": "│ ├",
        "keyColor": "green",
    },
    {
    "type": "terminal",
    "key": "│ └",
    "keyColor": "yellow"
    },
    {
    "type": "host",
    "key": "󰌢 SYSTEM",
    "keyColor": "white"
    },

    {
    "type": "battery",
    "key": "󰌢 BATTERY",
    "keyColor": "blue"
    },

    {
    "type": "cpu",
    "key": "│ ├󰻠",
    "keyColor": "white"
    },
    {
    "type": "gpu",
    "key": "│ ├󰻑",
    "keyColor": "red"
    },
    {
    "type": "disk",
    "key": "│ ├",
    "keyColor": "cyan",
    "format": "{size-used} / {size-total} ({size-percentage}) - ({mountpoint}) {filesystem}"
    },
    {
    "type": "memory",
    "key": "│ ├",
    "keyColor": "green"
    },
    {
    "type": "swap",
    "key": " SWAP",
    "keyColor": "green"
    },
    {
    "type": "uptime",
    "key": "│ ├󰅐",
    "keyColor": "blue"
    },
    {
    "type": "display",
    "key": "│ └󰍹",
    "keyColor": "blue"
    },
    {
    "type": "publicip",
    "key": "│ └󰀂",
    "keyColor": "yellow"
    },
    {
    "type": "localip",
    "key": "│ └󰀂",
    "keyColor": "yellow"
    },
    {
    "type": "sound",
    "key": " AUDIO",
    "format": "{2}",
    "keyColor": "magenta"
    },
    {
    "type": "player",
    "key": "│ ├󰥠",
    "keyColor": "magenta"
    },
    {
    "type": "media",
    "key": "│ └󰝚",
    "keyColor": "magenta"
    },
    { 
    "type": "custom",
    },
    {
            "type": "command",
            "key": "OS Age",
            "keyColor": "light_blue",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "uptime",
            "key": "Uptime",
            "keyColor": "light_blue"
        },
        {
            "type": "datetime",
            "key": "DateTime",
            "keyColor": "light_blue"
        },
    {
    "type": "custom",
    },
  {
  "type": "colors",
  },



  ]
  }
