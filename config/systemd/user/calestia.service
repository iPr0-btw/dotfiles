[Unit]
Description=caelestia shell
After=default.target

[Service]
Type=simple
ExecStart=/usr/bin/qs -c caelestia -n
ExecReload=/usr/bin/kill -9 qs
Restart=on-failure
RestartSec=1.23
TimeoutStopSec=10
ExecStopPost=/usr/bin/systemctl --user restart calestia.service

[Install]
WantedBy=default.target
