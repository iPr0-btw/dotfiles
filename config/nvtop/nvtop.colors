# NVTOP Color Configuration Template
# Format: color_name = RGB_HEX_VALUE
# Colors must be specified as 6-digit hex values without # prefix

# Background colors
background = #121317
selected_bg = #1e2023
header_bg = #43474f

# Text colors
text = #e3e2e7
selected_text = #aac7ff
header_text = #c4c6d0
inactive_text = #8e909a

# GPU utilization colors (gradient from low to high)
gpu_util_low = #c3e4ff
gpu_util_med = #d0f9f4
gpu_util_high = #a9adff

# Memory usage colors
memory_low = #c8e2ff
memory_med = #a4caff
memory_high = #9abdff

# Temperature colors (cool to hot)
temp_cool = #c3e4ff
temp_warm = #d0f9f4
temp_hot = #a9adff

# Power usage colors
power_low = #c3e4ff
power_med = #e0c2f9
power_high = #b9baf1

# Process list colors
process_normal = #e3e2e7
process_highlight = #aac7ff
process_killed = #a9adff

# Border and separator colors
border = #8e909a
separator = #43474f

# Chart and graph colors
chart_line = #ecb4ed
chart_fill = #1e2023

# Status indicators
status_ok = #c3e4ff
status_warning = #d0f9f4
status_error = #a9adff
status_info = #9abdff
