# NVTOP Color Configuration Template
# Format: color_name = RGB_HEX_VALUE
# Colors must be specified as 6-digit hex values without # prefix

# Background colors
background = #000000
selected_bg = #1A1A1A
header_bg = #1A1A1A

# Text colors
text = #FFFFFF
selected_text = #FFFFFF
header_text = #FFFFFF
inactive_text = #CCCCCC

# GPU utilization colors (gradient from low to high)
gpu_util_low = #55FF55
gpu_util_med = #FFFF55
gpu_util_high = #FF5555

# Memory usage colors
memory_low = #55FFFF
memory_med = #55FFFF
memory_high = #5555FF

# Temperature colors (cool to hot)
temp_cool = #55FF55
temp_warm = #FFFF55
temp_hot = #FF5555

# Power usage colors
power_low = #55FF55
power_med = #FFFFFF
power_high = #FF8888

# Process list colors
process_normal = #FFFFFF
process_highlight = #FFFFFF
process_killed = #FF5555

# Border and separator colors
border = #CCCCCC
separator = #666666

# Chart and graph colors
chart_line = #FFFFFF
chart_fill = #1A1A1A

# Status indicators
status_ok = #55FF55
status_warning = #FFFF55
status_error = #FF5555
status_info = #5555FF
