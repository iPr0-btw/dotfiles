# NVTOP Color Configuration Template
# Format: color_name = RGB_HEX_VALUE
# Colors must be specified as 6-digit hex values without # prefix

# Background colors
background = #0F0F14
selected_bg = #161619
header_bg = #1A1B26

# Text colors
text = #C0CAF5
selected_text = #000000
header_text = #A9B1D6
inactive_text = #565F89

# GPU utilization colors (gradient from low to high)
gpu_util_low = {{ $green }}
gpu_util_med = {{ $yellow }}
gpu_util_high = {{ $red }}

# Memory usage colors
memory_low = {{ $teal }}
memory_med = {{ $sapphire }}
memory_high = {{ $blue }}

# Temperature colors (cool to hot)
temp_cool = {{ $green }}
temp_warm = {{ $yellow }}
temp_hot = {{ $red }}

# Power usage colors
power_low = {{ $green }}
power_med = {{ $peach }}
power_high = {{ $maroon }}

# Process list colors
process_normal = #C0CAF5
process_highlight = #000000
process_killed = {{ $red }}

# Border and separator colors
border = #565F89
separator = #2A2F41

# Chart and graph colors
chart_line = #BB9AF7
chart_fill = #161619

# Status indicators
status_ok = {{ $green }}
status_warning = {{ $yellow }}
status_error = {{ $red }}
status_info = {{ $blue }}
