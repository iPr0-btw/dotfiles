# NVTOP Color Configuration Template
# Format: color_name = RGB_HEX_VALUE
# Colors must be specified as 6-digit hex values without # prefix

# Background colors
background = #000000
selected_bg = {{ $surfaceContainer }}
header_bg = #000000

# Text colors
text = #FFFFFF
selected_text = #0080FF
header_text = #CCCCCC
inactive_text = #555555

# GPU utilization colors (gradient from low to high)
gpu_util_low = {{ $green }}
gpu_util_med = {{ $yellow }}
gpu_util_high = {{ $red }}

# Memory usage colors
memory_low = {{ $teal }}
memory_med = {{ $sapphire }}
memory_high = {{ $blue }}

# Temperature colors (cool to hot)
temp_cool = {{ $green }}
temp_warm = {{ $yellow }}
temp_hot = {{ $red }}

# Power usage colors
power_low = {{ $green }}
power_med = {{ $peach }}
power_high = {{ $maroon }}

# Process list colors
process_normal = #FFFFFF
process_highlight = #0080FF
process_killed = {{ $red }}

# Border and separator colors
border = #555555
separator = {{ $outlineVariant }}

# Chart and graph colors
chart_line = #FF00FF
chart_fill = {{ $surfaceContainer }}

# Status indicators
status_ok = {{ $green }}
status_warning = {{ $yellow }}
status_error = {{ $red }}
status_info = {{ $blue }}
