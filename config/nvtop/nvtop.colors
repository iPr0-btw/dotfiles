# NVTOP Color Configuration Template
# Format: color_name = RGB_HEX_VALUE
# Colors must be specified as 6-digit hex values without # prefix

# Background colors
background = #121317
selected_bg = #1e2023
header_bg = #43474f

# Text colors
text = #e3e2e7
selected_text = #a8c8ff
header_text = #c3c6d0
inactive_text = #8d919a

# GPU utilization colors (gradient from low to high)
gpu_util_low = #c1e4ff
gpu_util_med = #d0f9f4
gpu_util_high = #a6aeff

# Memory usage colors
memory_low = #c7e3ff
memory_med = #a1caff
memory_high = #97beff

# Temperature colors (cool to hot)
temp_cool = #c1e4ff
temp_warm = #d0f9f4
temp_hot = #a6aeff

# Power usage colors
power_low = #c1e4ff
power_med = #e0c2f9
power_high = #b7baf1

# Process list colors
process_normal = #e3e2e7
process_highlight = #a8c8ff
process_killed = #a6aeff

# Border and separator colors
border = #8d919a
separator = #43474f

# Chart and graph colors
chart_line = #ebb5ec
chart_fill = #1e2023

# Status indicators
status_ok = #c1e4ff
status_warning = #d0f9f4
status_error = #a6aeff
status_info = #97beff
